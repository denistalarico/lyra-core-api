PORT=3000

DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=lyra
DB_PASSWORD=lyra_dev_password
DB_NAME=lyra_core

AGENCY_DB_HOST=localhost
AGENCY_DB_PORT=5433
AGENCY_DB_USERNAME=lyra
AGENCY_DB_PASSWORD=lyra_dev_password
AGENCY_DB_NAME=lyra_agency

JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_2FA_SECRET=change-me-2fa-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# Required when NODE_ENV=production: the API refuses to boot without it, and
# refuses to boot with the development fallback secret.
SETTINGS_ENCRYPTION_KEY=lyra_dev_32_chars_secret_key_01
META_WEBHOOK_VERIFY_TOKEN=lyra_meta_dev_verify_token

# Lyra Social — Meta Ads connection (read-only).
# The callback is its own whitelisted redirect URI in the Meta app, separate
# from META_FACEBOOK_OAUTH_CALLBACK_URL, so Social does not route through the
# Inbox channel callback. The login config must grant ads_read and
# business_management; ads_management is deliberately not requested.
# Callback shape: <api-host>/api/social/integrations/meta-ads/callback
SOCIAL_META_ADS_LOGIN_CONFIG_ID=
SOCIAL_META_ADS_OAUTH_CALLBACK_URL=

APP_FRONTEND_URL=https://lyrasuite.com

# Where the Meta Ads callback sends the browser back to. Optional: left empty,
# Social falls back to APP_FRONTEND_URL, which is the host that serves it.
SOCIAL_FRONTEND_URL=

SUITE_FRONTEND_URL=https://app.lyrasuite.com
LEADFLOW_FRONTEND_URL=https://leadflow.lyrasuite.com
AGENCY_FRONTEND_URL=https://agency.lyrasuite.com
ADMIN_FRONTEND_URL=https://admin.lyrasuite.com

SMTP_FROM_NAME=Lyra Platform
SMTP_FROM_EMAIL=no-reply@lyrasuite.com

AGENCY_PRODUCT_NAME=Lyra Agency
AGENCY_EMAIL_DOMAIN=lyrasuite.com
AGENCY_SMTP_FROM_NAME=Lyra Agency
AGENCY_SMTP_FROM_EMAIL=no-reply@lyrasuite.com
AGENCY_OWNER_NAME=Denis Talarico
AGENCY_OWNER_EMAIL=
AGENCY_OWNER_PASSWORD=
AGENCY_OWNER_WORKSPACE_NAME=Talarico Labs

# Two independent secrets — never the same value, and never reused from the
# JWT_* above. Production must replace both; the API refuses to boot with
# either one empty.
ADMIN_JWT_ACCESS_SECRET=change-me-admin-access-secret
ADMIN_JWT_2FA_SECRET=change-me-admin-2fa-secret
ADMIN_ACCESS_TOKEN_TTL=10m
ADMIN_REFRESH_TOKEN_TTL=7d
ADMIN_WEB_ORIGIN=http://localhost:3004
ADMIN_WEB_URL=http://localhost:3004
ADMIN_INVITATION_TTL=72h

S3_ENDPOINT=http://localhost:9200
S3_BUCKET=lyra-assets
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=lyraadmin
S3_SECRET_ACCESS_KEY=lyra_minio_dev_password
S3_PUBLIC_BASE_URL=http://localhost:9200/lyra-assets
S3_FORCE_PATH_STYLE=true
S3_CREATE_BUCKET=true
S3_SET_PUBLIC_READ_POLICY=true

# LeadFlow Briefing ingestion (LF-RF-F4-002)
LEADFLOW_BRIEFING_CLAMAV_HOST=localhost
LEADFLOW_BRIEFING_CLAMAV_PORT=3310
LEADFLOW_BRIEFING_CLAMAV_TIMEOUT_MS=15000
LEADFLOW_BRIEFING_MAX_UPLOAD_BYTES=20971520
LEADFLOW_BRIEFING_MAX_URL_FETCH_BYTES=10485760
LEADFLOW_BRIEFING_MAX_PASTE_BYTES=204800
LEADFLOW_BRIEFING_MAX_TOTAL_BYTES_PER_SETTINGS=209715200
LEADFLOW_BRIEFING_URL_FETCH_TIMEOUT_MS=15000

# LeadFlow Briefing extraction worker (LF-RF-F4-003) — reads process.env
# directly (same pattern as the Inbox runtime config), not via ConfigModule.
LEADFLOW_BRIEFING_EXTRACTION_PROVIDER_MODE=disabled
LEADFLOW_BRIEFING_EXTRACTION_PROVIDER_BASE_URL=https://api.openai.com/v1
LEADFLOW_BRIEFING_EXTRACTION_PROVIDER_API_KEY=
LEADFLOW_BRIEFING_EXTRACTION_MODEL=gpt-5.6-luna
LEADFLOW_BRIEFING_EXTRACTION_TIMEOUT_MS=20000
LEADFLOW_BRIEFING_EXTRACTION_MAX_ATTEMPTS=2
LEADFLOW_BRIEFING_EXTRACTION_MAX_IMAGES_PER_JOB=3
LEADFLOW_BRIEFING_EXTRACTION_MAX_PDF_PAGES=30
LEADFLOW_BRIEFING_EXTRACTION_MAX_EXTRACTED_CHARS=40000
LEADFLOW_BRIEFING_EXTRACTION_DAILY_BUDGET_CENTS=500
LEADFLOW_BRIEFING_EXTRACTION_RESERVE_CENTS=5

# LiveKit meeting provider. Server-side only: the API signs a short-lived
# participant token with these and hands the browser the token, never the key.
# Create the key pair in the LiveKit Cloud dashboard (Settings → Keys).
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Web Push (VAPID) — generate with: npx web-push generate-vapid-keys
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=mailto:suporte@lyrasuite.com
