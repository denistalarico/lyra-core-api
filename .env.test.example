# Modelo para .env.test — o ambiente dos testes de integração PostgreSQL.
#
# Copie para .env.test (ignorado pelo git) e ajuste as credenciais locais:
#
#   cp .env.test.example .env.test
#
# Rode sempre por "pnpm test:postgres". Nunca faça `. ./.env` antes de rodar
# os specs gated: o .env aponta para lyra_agency, que é produção.
#
# Os dois nomes abaixo precisam terminar em _test ou _dev. O guard em
# src/testing/postgres-integration-guard.ts aborta a execução inteira antes de
# qualquer SQL se isso não for verdade — inclusive se a variável estiver
# ausente, porque o default do DataSource é justamente o banco de produção.

AGENCY_DB_HOST=localhost
AGENCY_DB_PORT=5433
AGENCY_DB_USERNAME=lyra
AGENCY_DB_PASSWORD=troque-pela-senha-local
AGENCY_DB_NAME=lyra_agency_test

DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=lyra
DB_PASSWORD=troque-pela-senha-local
DB_NAME=lyra_core_test
